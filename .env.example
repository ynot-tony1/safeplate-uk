# Copy to .env and fill in locally. Never commit the real .env file.
# Production secrets are never stored here — they live in GitHub Actions
# secrets and Vercel project environment variables.

# --- Database (packages/database, apps/web) ---
# Full connection string for the least-privilege "app" role (read-mostly).
# Format: postgresql://food_app:<password>@<host>:26257/food_hygiene?sslmode=verify-full
DATABASE_URL=

# --- Ingestion service (services/ingestor) ---
# Connection string for the "ingestor" role (read/write on establishment data,
# no DDL, no other-database access).
INGEST_DATABASE_URL=

# --- Migrations (run manually via workflow_dispatch only) ---
# Connection string for the "migrator" role (DDL rights, used only by
# `prisma migrate deploy`, never by the running application).
MIGRATION_DATABASE_URL=

# --- Web app public config (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Shared ---
LOG_LEVEL=info
